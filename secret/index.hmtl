<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>♡ little secret ♡</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Trebuchet MS", Arial, sans-serif;
      background: #dff5ff;
      color: #536b78;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Floating decorations */
    .bubble {
      position: fixed;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.45);
      pointer-events: none;
      animation: float 7s infinite ease-in-out;
    }

    .bubble:nth-child(1) {
      width: 80px;
      height: 80px;
      top: 10%;
      left: 8%;
    }

    .bubble:nth-child(2) {
      width: 45px;
      height: 45px;
      top: 65%;
      left: 15%;
      animation-delay: 1s;
    }

    .bubble:nth-child(3) {
      width: 65px;
      height: 65px;
      top: 25%;
      right: 10%;
      animation-delay: 2s;
    }

    .bubble:nth-child(4) {
      width: 30px;
      height: 30px;
      bottom: 12%;
      right: 20%;
      animation-delay: 3s;
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    /* Main page */
    #cutePage {
      min-height: 100vh;
      padding: 60px 20px;
      text-align: center;
    }

    .container {
      max-width: 900px;
      margin: auto;
    }

    .tiny-title {
      font-size: 15px;
      letter-spacing: 4px;
      color: #8aa8b8;
      margin-bottom: 10px;
    }

    h1 {
      font-size: 58px;
      color: #6e9fb5;
      margin-bottom: 15px;
      text-shadow: 3px 3px 0 white;
    }

    .subtitle {
      font-size: 17px;
      color: #78919d;
      margin-bottom: 40px;
    }

    /* Cute character */
    .character {
      width: 170px;
      height: 170px;
      background: #fff;
      border-radius: 48% 48% 45% 45%;
      margin: 0 auto 40px;
      position: relative;
      box-shadow: 0 10px 30px rgba(100, 160, 180, 0.18);
    }

    .ear {
      position: absolute;
      width: 55px;
      height: 70px;
      background: #fff;
      border-radius: 50%;
      top: -35px;
    }

    .ear.left {
      left: 15px;
      transform: rotate(-20deg);
    }

    .ear.right {
      right: 15px;
      transform: rotate(20deg);
    }

    .ear::after {
      content: "";
      position: absolute;
      width: 25px;
      height: 40px;
      background: #ffdce9;
      border-radius: 50%;
      left: 15px;
      top: 15px;
    }

    .eye {
      position: absolute;
      width: 13px;
      height: 18px;
      background: #536b78;
      border-radius: 50%;
      top: 70px;
    }

    .eye.left {
      left: 48px;
    }

    .eye.right {
      right: 48px;
    }

    .blush {
      position: absolute;
      width: 28px;
      height: 12px;
      background: #ffd5e4;
      border-radius: 50%;
      top: 96px;
    }

    .blush.left {
      left: 25px;
    }

    .blush.right {
      right: 25px;
    }

    .mouth {
      position: absolute;
      left: 73px;
      top: 95px;
      font-size: 18px;
    }

    /* Cards */
    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-bottom: 45px;
    }

    .card {
      background: rgba(255,255,255,0.8);
      border: 2px solid white;
      border-radius: 25px;
      padding: 25px 15px;
      box-shadow: 0 8px 20px rgba(100, 160, 180, 0.12);
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-7px) rotate(1deg);
    }

    .card .emoji {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .card h2 {
      font-size: 18px;
      color: #6e9fb5;
      margin-bottom: 8px;
    }

    .card p {
      font-size: 14px;
      line-height: 1.6;
    }

    /* Secret button */
    .secret-area {
      margin-top: 20px;
    }

    .secret-text {
      font-size: 12px;
      color: #a1b7c1;
      margin-bottom: 12px;
    }

    #secretButton {
      border: none;
      background: transparent;
      font-size: 24px;
      cursor: pointer;
      opacity: 0.45;
      transition: 0.3s;
    }

    #secretButton:hover {
      opacity: 1;
      transform: scale(1.2);
    }

    footer {
      margin-top: 50px;
      font-size: 12px;
      color: #91aab5;
    }

    /* Secret page */
    #secretPage {
      display: none;
      min-height: 100vh;
      background: #10141a;
      color: #d8e0e5;
      text-align: center;
      padding: 70px 20px;
      position: relative;
    }

    #secretPage .secret-box {
      max-width: 650px;
      margin: auto;
      padding: 45px 30px;
      border: 1px solid #36414b;
      background: #151b21;
      box-shadow: 0 0 50px rgba(0,0,0,0.5);
    }

    #secretPage h2 {
      font-size: 38px;
      margin-bottom: 20px;
      letter-spacing: 3px;
    }

    #secretPage p {
      line-height: 1.8;
      color: #9daab2;
      margin-bottom: 30px;
    }

    .eye-secret {
      font-size: 70px;
      margin-bottom: 25px;
      animation: blink 4s infinite;
    }

    @keyframes blink {
      0%, 45%, 50%, 100% {
        opacity: 1;
      }
      47% {
        opacity: 0.1;
      }
    }

    .back-button {
      padding: 10px 20px;
      border: 1px solid #66737c;
      background: transparent;
      color: #c8d1d6;
      border-radius: 20px;
      cursor: pointer;
    }

    .back-button:hover {
      background: #252e35;
    }

    @media (max-width: 700px) {
      h1 {
        font-size: 42px;
      }

      .cards {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <!-- Floating bubbles -->
  <div class="bubble"></div>
  <div class="bubble"></div>
  <div class="bubble"></div>
  <div class="bubble"></div>

  <!-- CUTE PAGE -->
  <section id="cutePage">

    <div class="container">

      <div class="tiny-title">
        WELCOME TO MY LITTLE CORNER ♡
      </div>

      <h1>♡ tiny things ♡</h1>

      <p class="subtitle">
        a small website full of cute things
